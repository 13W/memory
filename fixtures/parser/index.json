        {
          "unit_kind": "symbol",
          "span_start": 68,
          "span_end": 80,
          "local_name": "E",
          "kind": "enum",
          "anchor": "p:enum:E",
          "parent": null
        },
        {
          "unit_kind": "symbol",
          "span_start": 81,
          "span_end": 97,
          "local_name": "T",
          "kind": "type_alias",
          "anchor": "p:type_alias:T",
          "parent": null
        },
        {
          "unit_kind": "symbol",
          "span_start": 98,
          "span_end": 112,
          "local_name": "N",
          "kind": "namespace",
          "anchor": "p:namespace:N",
          "parent": null
