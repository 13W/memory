      },
      "language": "typescript",
      "category": "syntax",
      "source": "export function foo(a: number): void {}\nclass Bar {}\ninterface I {}\nenum E { A }\ntype T = number;\nnamespace N {}\nexport const g = (x: number) => x;\n",
