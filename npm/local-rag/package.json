    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@13w/local-rag-darwin-arm64": "0.0.0",
    "@13w/local-rag-darwin-x64": "0.0.0",
    "@13w/local-rag-linux-x64": "0.0.0",
    "@13w/local-rag-linux-arm64": "0.0.0",
    "@13w/local-rag-win32-x64": "0.0.0"
  }
}
