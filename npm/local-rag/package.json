{
  "name": "@13w/local-rag",
  "version": "0.0.0",
  "description": "npm launcher for local-rag: resolves the platform-specific native binaries and runs the stdio MCP proxy.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bin": {
    "local-rag-mcp": "bin/local-rag-mcp.js"
  },
  "files": [
